# Locally generated. Gitignored, so a CI checkout never has them, but a
# local `docker build` would copy them in: a packages.php built with dev
# dependencies makes the --no-dev image fail on a missing provider, and
# generated Wayfinder files would mask a broken build-time generation.
bootstrap/cache/*.php
resources/js/actions
resources/js/routes
resources/js/wayfinder
.phpunit.result.cache
.phpunit.cache
